# ==========================================
# DirectR .gitignore
# ==========================================

# Ignore all images and screenshots
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tiff
*.ico
*.svg.bak
Screenshot*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node / Web (if any UI / frontend is added)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/

# Environment and Secrets
.env
.env.*
!.env.example
*.pem
*.key

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Logs and outputs
logs/
*.log
output/
temp/
scratch/
